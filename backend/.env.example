DJANGO_SECRET_KEY=generate-with-python-secrets-token_urlsafe-50
DJANGO_DEBUG=true
DATABASE_URL=postgresql://localhost/ai_rag_agent
REDIS_URL=redis://127.0.0.1:6379/0
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemma3:4b
LLM_FALLBACK_MODELS=llama3.1:8b,qwen2.5:3b

# Speech recognition (see README → Speech recognition). IndicConformer is gated on Hugging Face: run `hf auth login`.
# INDIC_ASR_MODEL=ai4bharat/indic-conformer-600m-multilingual
# INDIC_DECODING=ctc        # ctc (best Telugu WER) | rnnt
# INDIC_INT8=true           # int8 encoder: 1 GB less RAM, 30% faster, same CER
# MODEL_IDLE_UNLOAD_SECONDS=600

# --- Messenger ---
# SMS for phone verification: twilio (Twilio Verify) or dev (DEBUG only; codes go to backend/data/dev_sms_outbox/)
SMS_BACKEND=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
MESSENGER_MAX_UPLOAD_BYTES=104857600
MESSENGER_QUOTA_BYTES=2147483648
# ICE servers for WebRTC calls (JSON). Empty = same machine / same network only.
WEBRTC_ICE_SERVERS=[]

# --- Production (Render) ---
# COOKIE_DOMAIN=.pvsairamsaketh.in        # share the login between aura.pvsairamsaketh.in and api.aura.pvsairamsaketh.in
# SECURE_COOKIES=true
# BEHIND_HTTPS_PROXY=true
# OLLAMA_API_KEY=                         # bearer token if OLLAMA_BASE_URL is a remote, authenticated endpoint

# --- Cloud LLM (Render and other hosts without Ollama) ---
# LLM_PROVIDER=openai                       # default: ollama
# LLM_BASE_URL=https://api.openai.com/v1    # any OpenAI-compatible API
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
# EMBEDDING_BASE_URL=                       # defaults to LLM_BASE_URL
# EMBEDDING_API_KEY=                        # defaults to LLM_API_KEY
# LOCAL_SPEECH=false                        # speech models need ~4 GB RAM
