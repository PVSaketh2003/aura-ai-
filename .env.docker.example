# Copy to .env next to docker-compose.yml. Never commit the real file.
POSTGRES_PASSWORD=change-me
DJANGO_SECRET_KEY=replace-with-50-plus-random-characters-replace-with-50-plus-random
DOCKERHUB_NAMESPACE=your-dockerhub-username
TAG=latest
